public class WeekTwo {

    public static void main(String[] args) {
        
      double balance = 1350.0;

        System.out.println("===== COMPOUND GROWTH =====");

        System.out.println("Initial Balance: " + balance);

        balance += 375;
        System.out.println("After adding 375: " + balance);

        balance *= 3;
        System.out.println("After multiplying by 3: " + balance);

        balance -= 425;
        System.out.println("After subtracting 425: " + balance);

        System.out.println("===================");

        int count = 8;

        System.out.println("Using Postfix Increment:");
        System.out.println(count++);
        System.out.println(count);

        System.out.println("===================");

        count = 8;

        System.out.println("Using Prefix Increment:");
        System.out.println(++count);
        System.out.println(count);

        /* Postfix (count++) prints the original value first,
           then increases the value by one.
           Prefix (++count) increases the value first,
           then prints the updated value.  */
      
        
    }
}
