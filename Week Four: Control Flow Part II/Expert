package com.mycompany.weekfour;

import java.util.Scanner;
/**
 *
 * @author Texon, Broderick Jr. M.
 */
public class WeekFour {

    public static void main(String[] args) {
        
        Scanner sc = new Scanner(System.in);

        /* -1 means the shelf is damaged. */
        int[][] inventory = {
            {10, 5, 8},
            {12, -1, 3},
            {7, 2, 15}
        };

        int choice;

        do {
            System.out.println("===========WAREHOUSE INVENTORY===========");
            System.out.println("1. Display Inventory");
            System.out.println("2. Calculate Total Inventory");
            System.out.println("3. Find Critically Low Shelf");
            System.out.println("4. Restock Shelf");
            System.out.println("5. Exit");
            System.out.print("Enter your choice: ");
            
           

            choice = sc.nextInt();

            switch (choice) {

                case 1:
                    System.out.println("Inventory Table:");

                    for (int row = 0; row < inventory.length; row++) {
                        for (int column = 0;
                             column < inventory[row].length;
                             column++) {

                            if (inventory[row][column] == -1) {
                                System.out.print("DAMAGED\t");
                                continue;
                            }

                            System.out.print(inventory[row][column] + "\t");
                        }

                        System.out.println();
                    }
                    break;

                case 2:
                    int total = 0;

                    for (int row = 0; row < inventory.length; row++) {
                        for (int column = 0;
                             column < inventory[row].length;
                             column++) {

                            /* Skip damaged shelves. */
                            if (inventory[row][column] == -1) {
                                continue;
                            }

                            total += inventory[row][column];
                        }
                    }

                    System.out.println("Total Inventory: " + total);
                    break;

                case 3:
                    boolean found = false;

                    for (int row = 0; row < inventory.length; row++) {
                        for (int column = 0;
                             column < inventory[row].length;
                             column++) {

                            if (inventory[row][column] == -1) {
                                continue;
                            }

                            if (inventory[row][column] <= 3) {
                                System.out.println(
                                    "Critically low shelf found at Row "
                                    + (row + 1) + ", Column "
                                    + (column + 1)
                                    + " | Items: "
                                    + inventory[row][column]
                                );

                                found = true;
                                break;
                            }
                        }

                        /* Stop searching after the first low shelf. */
                        if (found) {
                            break;
                        }
                    }

                    if (!found) {
                        System.out.println("No critically low shelf found.");
                    }
                    break;

                case 4:
                    System.out.print("Enter row (1-3): ");
                    int row = sc.nextInt();

                    System.out.print("Enter column (1-3): ");
                    int column = sc.nextInt();

                    /* Validate the shelf coordinates. */
                    if (row < 1 || row > 3 ||
                        column < 1 || column > 3) {

                        System.out.println("Invalid shelf location.");

                    } else if (inventory[row - 1][column - 1] == -1) {

                        System.out.println("Cannot restock a damaged shelf.");

                    } else {

                        int amount;

                        System.out.print("Enter quantity to add: ");
                        amount = sc.nextInt();

                        /* Repeat until the quantity is valid. */
                        while (amount <= 0) {
                            System.out.println(
                                "Invalid quantity. Enter a number greater than 0."
                            );
                            System.out.print("Enter quantity to add: ");
                            amount = sc.nextInt();
                        }

                        inventory[row - 1][column - 1] += amount;

                        System.out.println("Restocking successful.");
                        System.out.println(
                            "Updated Quantity: "
                            + inventory[row - 1][column - 1]
                        );
                    }
                    break;

                case 5:
                    System.out.println("Exiting Warehouse Inventory...");
                    break;

                default:
                    System.out.println("Invalid choice. Please try again.");
            }

        } while (choice != 5);

        sc.close();
        
        System.out.print("=========================================");

    }
}
