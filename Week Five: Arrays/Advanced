package com.mycompany.weekfive;

import java.util.Arrays;
/**
 *
 * @author Texon, Broderick Jr. M.
 */
public class WeekFive {

    public static void main(String[] args) {
        
        System.out.println("===========SEARCH AND SORT===========");

        int[] scores = {85, 90, 78, 95, 82, 88};
        int target = 95;
        int foundAt = -1;

        System.out.println("Original Array: " + Arrays.toString(scores));

        /* Linear search */
        for (int i = 0; i < scores.length; i++) {
            if (scores[i] == target) {
                foundAt = i;
                break;
            }
        }

        if (foundAt != -1) {
            System.out.println("Target Found: " + target);
            System.out.println("Found at Index: " + foundAt);
        } else {
            System.out.println("Target Not Found: " + target);
        }

        System.out.println("=====================================");

        /* Copy the array before sorting. */
        int[] sortedScores = Arrays.copyOf(scores, scores.length);

        Arrays.sort(sortedScores);

        System.out.println("Original Array: " + Arrays.toString(scores));
        System.out.println("Sorted Array: " + Arrays.toString(sortedScores));

        /* Sorting a copy keeps the original array unchanged,
           preserving its original order and index positions. */
        
        System.out.println("=====================================");
        
    }
}
