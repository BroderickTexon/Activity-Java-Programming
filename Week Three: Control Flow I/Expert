package com.mycompany.weekthree;

import java.util.Scanner;

/**
 *
 * @author Texon, Broderick Jr. M.
 */
public class WeekThree {
    public static void main(String[] args) {
        
       Scanner input = new Scanner(System.in);

        // Registered account
        String correctUsername = "BrodPogi";
        int correctPIN = 1267;

        System.out.println("===== ATM TRANSACTION AUTHORIZER =====");

        System.out.print("Enter username: ");
        String username = input.nextLine();

        System.out.print("Enter 4-digit PIN: ");
        int pin = input.nextInt();

        // 1. Nested if: Check username and PIN
        if (username.equals(correctUsername)) {
            if (pin >= 1000 && pin <= 9999 && pin == correctPIN) {

                System.out.println("\nLogin successful!");

                System.out.print("Enter account balance: ");
                double balance = input.nextDouble();

                System.out.print("Enter withdrawal amount: ");
                double amount = input.nextDouble();

                System.out.print("Enter amount already withdrawn today: ");
                double withdrawnToday = input.nextDouble();

                // 2. If-else-if ladder: Determine account tier
                String tier;
                double dailyLimit;

                if (balance < 5000) {
                    tier = "Bronze";
                    dailyLimit = 5000;
                } else if (balance < 20000) {
                    tier = "Silver";
                    dailyLimit = 10000;
                } else if (balance < 50000) {
                    tier = "Gold";
                    dailyLimit = 20000;
                } else {
                    tier = "Platinum";
                    dailyLimit = 50000;
                }

                // 3. Switch: Determine transaction fee
                double feeRate;

                switch (tier) {
                    case "Bronze":
                        feeRate = 0.02;
                        break;
                    case "Silver":
                        feeRate = 0.015;
                        break;
                    case "Gold":
                        feeRate = 0.01;
                        break;
                    case "Platinum":
                        feeRate = 0.005;
                        break;
                    default:
                        feeRate = 0.0;
                }

                double fee = amount * feeRate;
                double totalDeduction = amount + fee;

                System.out.println("\n===== ACCOUNT DETAILS =====");
                System.out.println("Account Tier: " + tier);
                System.out.println("Account Balance: " + balance);
                System.out.println("Daily Withdrawal Limit: " + dailyLimit);
                System.out.printf("Transaction Fee: %.2f%n", fee);

                // 4. If-else: Approve or deny transaction
                if (amount <= 0) {
                    System.out.println(
                        "DENIED: Withdrawal amount must be greater than zero."
                    );
                } else {
                    // Nested if: Check balance and daily limit
                    if (totalDeduction <= balance) {

                        if (withdrawnToday + amount <= dailyLimit) {

                            System.out.println("\nTRANSACTION APPROVED!");
                            System.out.printf(
                                "Withdrawal Amount: %.2f%n", amount
                            );
                            System.out.printf(
                                "Transaction Fee: %.2f%n", fee
                            );
                            System.out.printf(
                                "Total Deduction: %.2f%n", totalDeduction
                            );
                            System.out.printf(
                                "Remaining Balance: %.2f%n",
                                balance - totalDeduction
                            );

                        } else {
                            System.out.println(
                                "DENIED: Daily withdrawal limit exceeded."
                            );
                        }

                    } else {
                        System.out.println(
                            "DENIED: Insufficient balance to cover " +
                            theTransactionCost()
                        );
                    }
                }

            } else {
                System.out.println(
                    "ACCESS DENIED: Incorrect PIN or PIN is not 4 digits."
                );
            }

        } else {
            System.out.println("ACCESS DENIED: Incorrect username.");
        }

        input.close();
    }

    static String theTransactionCost() {
        return "the withdrawal amount and transaction fee.";
    
        
    }
}
